#!/bin/sh
# Gate de verificação local (Onda 0 / R1) — CLAUDE.md §6.
# Roda `npm run verify` (lint + typecheck + build + test + audit) ANTES de qualquer push.
# Vermelho NÃO entra: se algo falhar, o push é abortado.
#
# Ativação (uma vez por clone):  git config core.hooksPath .githooks
# (Em POSIX garanta o bit de exec:  chmod +x .githooks/pre-push)
#
# Este é o gate primário que NÃO depende de nuvem; o GitHub Actions (.github/workflows/ci.yml)
# é o reforço onde houver remoto.

set -e

echo "[pre-push] rodando 'npm run verify' (lint + typecheck + build + test + audit)..."
npm run verify

echo "[pre-push] verify VERDE — push liberado."
