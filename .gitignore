# Logs
*.log

node_modules
dist
dist-ssr
*.local

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Media de demo pesada (não versionar clipes grandes)
public/demo/*.mp4
public/demo/*.webm

# Fontes RTSP reais (podem conter credenciais)
server/rtsp.sources.json

# Câmeras cadastradas dinamicamente (CRUD em runtime — podem conter credenciais)
server/cameras.json

# Estado/credenciais de sessão do WhatsApp (Baileys) — nunca versionar
server/wa-auth/

# Artefatos de teste (Playwright)
test-results/
playwright-report/

# Log de eventos de alarme (runtime — só metadados, mas não versionar)
server/alarms.json

# Destinatários de WhatsApp (PII — números/nomes; LGPD) e config de notificações.
# Fallbacks JSON de runtime criados por recipients.js/settings.js quando o Postgres está off.
server/recipients.json
server/notif-settings.json

# Config de câmeras/views compartilhadas (runtime)
server/camcfg.json

# Shelves de alarme persistidas (runtime)
server/alarm-shelves.json

# Segredos / runtime que NÃO devem ser versionados (R0)
deploy/visao-hub.service
server/users.json

# Histórico em fallback JSON (runtime — só indicadores agregados)
server/data-hist.json
server/data-hist.json.tmp

# Modelo ONNX do motor de análise (baixado no boot com verificação de sha — ver server/analysis/README.md)
server/models/

# Scratchpad de trabalho/POC — NUNCA versionar (o scratchpad real fica fora do repo, em temp).
scratchpad/

# Binário go2rtc EMPACOTADO no release (baixado no build por scripts/fetch-go2rtc.mjs).
# Binário NUNCA versionado no git — vem no artefato de release, não no repo.
bin/

# go2rtc: yaml GERADO a partir das câmeras (contém URLs RTSP com credenciais) — nunca versionar.
# O default fica FORA do repo (dir do binário); estes patterns são trava de segurança extra.
go2rtc*.yaml
*.gen.yaml
server/go2rtc.yaml

# Bancada de acurácia (eval/): dados pesados COCO + resultados de execução NÃO são versionados.
# São versionados: os scripts, o manifest.json, o thresholds.json e o FIXTURE commitável
# (eval/fixture/ ~5MB — sensor de regressão npm run eval).
eval/data/
eval/last-results.json
eval/model-comparison.json

# dataset de eval (MOT20) — não versionar
archive.zip
server/bt-tags.json
tc22-scanner/build/
tc22-scanner/debug.keystore
