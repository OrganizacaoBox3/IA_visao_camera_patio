{
  "name": "visao_patio_mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-mediapipe.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/fetch-mediapipe.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "hub": "node server/index.js",
    "start": "node server/index.js",
    "cameras": "node scripts/cameras-demo.mjs",
    "e2e": "playwright test",
    "lint": "eslint .",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "audit": "npm audit --audit-level=high",
    "analyze": "node -e \"process.env.ANALYZE=1;require('child_process').execSync('vite build',{stdio:'inherit'})\"",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test && npm run audit",
    "eval": "node eval/gate.mjs",
    "eval:counting": "node eval/counting.mjs",
    "probe": "node scripts/probe-hardware.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
