    "@whiskeysockets/baileys": "^6.7.0",
    "@zxing/library": "^0.21.3",
    "lucide-react": "^1.23.0",
    "onnxruntime-node": "^1.27.0",
    "pg": "^8.21.0",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
