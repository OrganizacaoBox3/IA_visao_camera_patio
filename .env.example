# ══════════════════════════════════════════════════════════════════════════════
# .env.example — MAPA das variáveis de ambiente do visao_computacional_mvp
# ══════════════════════════════════════════════════════════════════════════════
# Uso:  cp .env.example .env   → descomente/preencha o que precisar.
#
#  • O HUB carrega <raiz>/.env no boot (server/env.js, 1ª linha do index.js).
#  • O FRONT (Vite) lê o MESMO arquivo nativamente — mas só VITE_* chega ao browser.
#  • PRECEDÊNCIA: variável setada no ambiente real (terminal, systemd
#    EnvironmentFile, CI) SEMPRE vence o arquivo. Em produção o systemd continua
#    a autoridade (deploy/visao-hub.service.example); o .env é o piso do dev.
#  • O .env real é GITIGNORED (contém segredos). Este example NUNCA leva valor real.
#  • Tudo aqui é OPCIONAL: comentado = default do código (anotado em cada linha).
#  • Knobs de QUALIDADE de detecção têm dono único (server/analysis/precision.js) —
#    mudou um, rode `npm run eval` (invariante D.10). O env é só o transporte.
#
# ── Núcleo / HTTP ─────────────────────────────────────────────────────────────
# HOST=0.0.0.0                      # bind do hub (prod atrás do nginx: 127.0.0.1)
# PORT=4000                         # porta do hub (socket.io + /api)
# NODE_ENV=development
#
# ── Auth / segredos (⚠ NUNCA versionar valores) ───────────────────────────────
# AUTH_SECRET=                      # ⚠ HMAC dos tokens de sessão — longo e único por site
# AUTH_TTL_MS=86400000              # validade do token (24h)
# SUPERADMIN_USER=                  # seed do 1º admin (só 1º boot; depois vive no store)
# SUPERADMIN_PASSWORD=              # ⚠ idem
# LOGIN_MAX_ATTEMPTS=5              # throttle de login (tentativas na janela)
# LOGIN_WINDOW_MS=60000
# CAMERA_TOKEN=                     # ⚠ token dos NÓS de câmera (socket role=camera)
# VIDEO_TICKET_TTL_MS=60000         # validade do ticket do proxy /go2rtc/*
#
# ── Postgres (fallback JSON automático quando ausente/fora) ──────────────────
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=
# PGPASSWORD=                       # ⚠
# PGDATABASE=visao_computacional    # (legado: VISAO_DB ainda é lido como alias)
# DATABASE_URL=                     # ⚠ alternativa em URL única (postgres://…)
# DATA_HIST_PATH=                   # override do arquivo do fallback (default server/data-hist.json)
# DATA_HIST_RETENTION_DAYS=30       # retenção do histórico agregado
#
# ── Ingest RTSP (ffmpeg → JPEG; server/rtsp.js) ───────────────────────────────
# RTSP_SOURCES=                     # legado: "label=rtsp://…;label2=…" (preferir cadastro na UI)
# RTSP_FPS=10                       # defaults de captura (por câmera sobrepõe no cadastro)
# RTSP_WIDTH=720
# RTSP_QUALITY=4                    # -q:v do ffmpeg (MENOR = melhor)
# RTSP_RECONNECT_BASE_MS=2000       # backoff de reconexão (1ª espera)
# RTSP_RECONNECT_MAX_MS=30000       # teto do backoff
# RTSP_MAX_RETRIES=0                # 0 = ilimitado
# RTSP_STALE_MS=15000               # sem frame por tanto = congelado → derruba/reconecta
# RTSP_STATUS_MS=5000               # cadência do refresh de fps/status (camera-status)
# FFMPEG_PATH=                      # binário explícito (senão: PATH + locais comuns)
#
# ── Shed (economia sem espectador; server/shed.js) ────────────────────────────
# SHED_IDLE_MS=15000                # fonte sem espectador por tanto → pausa (análise conta como espectador)
# SHED_SWEEP_MS=5000
# SHED_WEBCAM_FPS=2                 # fps rebaixado do nó webcam ocioso (≥ cadência de análise)
# SHED_VIGIL_MIN_FPS=2
# WEBCAM_DEFAULT_FPS=12
#
# ── go2rtc (gateway WebRTC; auto-liga pela PRESENÇA de bin/go2rtc — sem flag) ─
# GO2RTC_ENABLED=                   # 0 desliga MESMO com o binário presente (escape hatch)
# GO2RTC_BIN=                       # caminho explícito do binário (default bin/go2rtc[.exe])
# GO2RTC_YAML=                      # config gerada (default junto do binário; contém credenciais)
# GO2RTC_API_PORT=1984
# GO2RTC_RTSP_PORT=8554
# GO2RTC_RTMP_PORT=1935             # ingest RTMP (DVR push) — ADR-019
# GO2RTC_WEBRTC_PORT=8555
# GO2RTC_WEBRTC_CANDIDATES=         # candidatos ICE extras (NAT/IP fixo), separados por vírgula
# GO2RTC_LOG_LEVEL=warn
# GO2RTC_SYNC_DEBOUNCE_MS=1500      # debounce do re-sync cameras→yaml
# GO2RTC_RESTART_BASE_MS=2000       # backoff do supervisor do binário
# GO2RTC_RESTART_MAX_MS=30000
#
# ── Ingest RTMP próprio (relay p/ push de DVR que o go2rtc não decodifica) ────
# RTMP_INGEST=                      # 1 liga o relay (server/rtmp-ingest.js)
# RTMP_AUTO_ENROLL=1                # canal RTMP novo vira câmera automaticamente
# RTMP_RELAY_HTTP_PORT=8890
#
# ── Motor de análise (D-FINE no hub — ADR-009; server/analysis/) ──────────────
# ANALYSIS_ENABLED=                 # 0=off · 1=on (baixa modelo no 1º boot) · ausente=on se modelo existe
# ANALYSIS_MODEL=                   # PIN n|s|m (fixa tier e DESLIGA o autoscale; ausente = AUTO)
# ANALYSIS_MODEL_PATH=              # .onnx explícito (eval/; desliga catálogo/fallback/autoscale)
# ANALYSIS_WORKERS=                 # nº de workers do pool (default min(cores/2, câmeras))
# ANALYSIS_FPS=1                    # cadência base por câmera
# ANALYSIS_FPS_LINE=2               # câmera COM tripwire (contagem precisa de cadência)
# ANALYSIS_FPS_FOCUS=6              # câmera ABERTA (alvo; o real depende da inferência)
# ANALYSIS_FOCUS_INFLIGHT=          # paralelismo da focada (default: max(pool-1, 2), teto pool — CA-3)
# ANALYSIS_FOCUS_INPUT=             # input MENOR só na focada (ex. 512): overlay mais fresco (Onda 1c)
# ANALYSIS_INTRA_THREADS=2          # threads intra-op do ORT por worker
# ANALYSIS_AGG_MS=3000              # janela do ingest "ativ"
# ── knobs de QUALIDADE (dono: precision.js — mudou, `npm run eval`) ──
# ANALYSIS_INPUT=640                # resize squash (múltiplo de 32; 896 = +recall denso, ~1.9× CPU)
# ANALYSIS_SCORE_MIN=0.25           # piso do worker (2ª passada do ByteTrack sustenta)
# ANALYSIS_HIGH_SCORE=0.35          # nascimento/1ª passada do tracker
# ANALYSIS_NMS_IOU=0.6
# ── gate de movimento (pula inferência em cena estática; nunca-cego) ──
# ANALYSIS_MOTION_GATE=1            # 0 desliga (escape hatch)
# ANALYSIS_MOTION_RATIO=0.005       # fração do thumbnail que precisa mudar
# ANALYSIS_MOTION_PROBE_MS=6000     # piso de probe (cena estática ainda roda a cada tanto)
# ANALYSIS_MOTION_PROBE_FOCUS_MS=2000
# ── auto-máscara de FP fixo (server/analysis/automask.js) ──
# ANALYSIS_AUTOMASK=                # shadow|on|off (ver automask.js)
# ANALYSIS_AUTOMASK_JITTER=
# ── pull go2rtc (câmera sem relé — frame.jpeg direto do gateway) ──
# ANALYSIS_GO2RTC_PULL=             # 1 liga o pull p/ câmera sem relé
# ANALYSIS_SOURCE=                  # go2rtc = força pull de TODAS as streams
# ANALYSIS_GO2RTC_STREAMS_MS=10000
# ANALYSIS_GO2RTC_TIMEOUT_MS=3000
#
# ── Fadiga no hub (F1a — spec-fadiga-no-hub; worker YuNet+FaceMesh dedicado) ──
# ANALYSIS_FADIGA=                  # 1 liga (default OFF até a validação lado a lado — Regra 11)
# ANALYSIS_FADIGA_THREADS=2
#
# ── Alarmes / alertas (server/alarm*, alerts.js, events.js) ───────────────────
# ALARM_POLICY_ENABLED=1
# ALARM_LOG_LEVEL=info
# ALARM_SHELVES_FILE=               # override do alarm-shelves.json
# ALARM_SHELVE_DEFAULT_MS=3600000
# ALARM_SHELVE_MAX_MS=28800000
# ALARM_DEDUP_MS=                   # dedup de alarme (alarmPolicy.js)
# ALERT_DEDUP_MS=60000              # dedup do webhook/Andon (alerts.js)
# ALERT_WEBHOOK_URL=                # webhook externo (Andon) — vazio desliga
# ALARM_FLAP_ENABLED=1              # supressão de flapping
# ALARM_FLAP_THRESHOLD=4
# ALARM_FLAP_WINDOW_MS=120000
# ALARM_FLAP_COOLDOWN_MS=300000
# ALARM_FLOOD_THRESHOLD=10          # resumo de enxurrada
# ALARM_FLOOD_WINDOW_MS=60000
# ALARM_FLOOD_SUMMARY_MS=300000
# ALARM_RATE_WINDOW_MS=86400000     # taxa de ack/lifecycle (relatório)
# ALARM_RATE_MIN_SAMPLE=20
# ALARM_RATE_WARN_THROTTLE_MS=3600000
# ALARM_CRITICAL_TARGET_PCT=80
# ALARM_EVENTS_RETENTION=1000       # nº máx. de eventos no log
# ALARM_EVENTS_RETENTION_DAYS=      # retenção por idade (persistência)
#
# ── WhatsApp (Baileys; server/whatsapp.js) ────────────────────────────────────
 WHATSAPP_ENABLED= 1                # 1 liga (QR no console no 1º pareamento; estado em wa-auth/)
#
# ── Control-plane (link site→central; server/control-plane-*.js) ──────────────
# CP_URL=                           # URL da central (vazio = link desligado)
# SITE_ID=                          # identidade deste site na central
# SITE_KEY=                         # ⚠ chave do site
# SITE_TZ=America/Sao_Paulo
# CP_TIMEOUT_MS=5000
# CP_HEARTBEAT_MS=30000
# CP_LINK_PING_MS=25000
# CP_LINK_BASE_MS=2000              # backoff de reconexão do link
# CP_LINK_MAX_MS=60000
#
# ── FRONT (Vite — build-time; só VITE_* chega ao browser) ─────────────────────
# VITE_HUB_URL=                     # força endpoint do hub (default: mesma origem/localhost:4000)
# VITE_GO2RTC_BASE=/go2rtc          # base do proxy go2rtc (dev pode apontar :1984 direto)
# VITE_WEBCAM_WHIP=                 # 0 = força nó webcam no JPEG legado (default: tenta WHIP)
#
# ── Scripts / dev (não são runtime do hub) ────────────────────────────────────
# PROBE_TIMEOUT_MS=20000            # scripts/validate-streams.mjs (ffprobe por fonte)
# ANALYZE=                          # 1 = vite build com bundle analyzer (vite.config.ts)
